generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  ADMIN
  MEMBER
}

enum RecipeUnit {
  GRAMS
  KILOGRAMS
  MILLILITERS
  LITERS
  TABLESPOONS
  OUNCES
  UNITS
}

// --- MODELOS ---
model Family {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique @default(uuid())
  createdAt  DateTime @default(now())

  users         User[]
  shoppingItems ShoppingItem[]
  tasks         Task[]
  ideasPlans    IdeaPlan[]
  recipes       Recipe[]

  @@map("families")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id])

  @@map("users")
}

model ShoppingItem {
  id        String   @id @default(uuid())
  name      String // Ej: "Leche", "Huevos"
  quantity  Int      @default(1)
  isBought  Boolean  @default(false) // Por defecto no está comprado
  createdAt DateTime @default(now()) // Para ordenarlos por fecha

  // Relación: Este producto pertenece a una Familia
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id @default(uuid())
  name      String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model IdeaPlan {
  id        String   @id @default(uuid())
  name      String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("ideas_plans")
}

model Recipe {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  familyId    String
  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  steps       RecipeStep[]

  @@map("recipes")
}

model RecipeIngredient {
  id        String     @id @default(uuid())
  name      String
  quantity  Float
  unit      RecipeUnit
  createdAt DateTime   @default(now())

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_ingredients")
}

model RecipeStep {
  id          String   @id @default(uuid())
  description String
  position    Int

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, position])
  @@map("recipe_steps")
}
