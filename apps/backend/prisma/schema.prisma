generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  ADMIN
  MEMBER
}

// --- MODELOS ---
model Family {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]

  @@map("families")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])

  @@map("users")
}