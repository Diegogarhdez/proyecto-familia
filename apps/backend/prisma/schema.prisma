generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  ADMIN
  MEMBER
}

enum RecipeUnit {
  GRAMS
  KILOGRAMS
  MILLILITERS
  LITERS
  TABLESPOONS
  OUNCES
  UNITS
}

// --- MODELOS ---
model Family {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique @default(uuid())
  createdAt  DateTime @default(now())

  users         User[]
  shoppingItems ShoppingItem[]
  tasks         Task[]
  ideasPlans    IdeaPlan[]
  recipes       Recipe[]
  incomes       MonthlyIncome[]
  expenseCategories ExpenseCategory[]
  expenses      Expense[]
  calendarEvents CalendarEvent[]

  @@map("families")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  emailVerified Boolean  @default(true)
  verificationCodeHash String?
  verificationCodeExpiresAt DateTime?

  familyId String
  family   Family @relation(fields: [familyId], references: [id])
  incomes  MonthlyIncome[]
  createdEvents CalendarEvent[]

  @@map("users")
}

model ShoppingItem {
  id        String   @id @default(uuid())
  name      String // Ej: "Leche", "Huevos"
  quantity  Int      @default(1)
  isBought  Boolean  @default(false) // Por defecto no está comprado
  createdAt DateTime @default(now()) // Para ordenarlos por fecha

  // Relación: Este producto pertenece a una Familia
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id @default(uuid())
  name      String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model IdeaPlan {
  id        String   @id @default(uuid())
  name      String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("ideas_plans")
}

model Recipe {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  familyId    String
  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  steps       RecipeStep[]

  @@map("recipes")
}

model RecipeIngredient {
  id        String     @id @default(uuid())
  name      String
  quantity  Float
  unit      RecipeUnit
  createdAt DateTime   @default(now())

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_ingredients")
}

model RecipeStep {
  id          String   @id @default(uuid())
  description String
  position    Int

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, position])
  @@map("recipe_steps")
}

model MonthlyIncome {
  id        String   @id @default(uuid())
  month     String
  amount    Float
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([familyId, month])
  @@map("monthly_incomes")
}

model ExpenseCategory {
  id           String   @id @default(uuid())
  name         String
  emoji        String
  monthlyLimit Float
  createdAt    DateTime @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id        String   @id @default(uuid())
  month     String
  name      String
  emoji     String
  amount    Float
  createdAt DateTime @default(now())

  familyId  String
  family    Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  categoryId String?
  category  ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([familyId, month])
  @@map("expenses")
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String   // Nombre/Título del evento
  description String?  // Descripción opcional (ej: "Llevar la comida")
  startAt     DateTime // Fecha y hora de inicio
  endAt       DateTime // Fecha y hora de fin
  isAllDay    Boolean  @default(false) // Si dura todo el día
  color       String   @default("#3b82f6") // Color en formato hex, por ejemplo azul de Tailwind
  category    String?  // Categoría opcional (ej: "Médico", "Cumpleaños", "Escuela", "Ocio")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  familyId  String
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([startAt, endAt])
  @@map("calendar_events")
}
